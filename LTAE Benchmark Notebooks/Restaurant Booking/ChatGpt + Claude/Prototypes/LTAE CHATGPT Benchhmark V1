mpy<2.1,>=1.22, but you have numpy 2.3.3 which is incompatible.\n","cudf-cu12 25.6.0 requires pandas<2.2.4dev0,>=2.0, but you have pandas 2.3.3 which is incompatible.\u001b[0m\u001b[31m\n","\u001b[0mSuccessfully installed matplotlib-3.10.7 numpy-2.3.3 openai-2.3.0 pandas-2.3.3\n"]},{"data":{"application/vnd.colab-display-data+json":{"id":"e2d7bbbee4b14b43b2e348e9674b15bb","pip_warning":{"packages":["matplotlib","mpl_toolkits","numpy"]}}},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["NOTE: Running many runs with GPT-5 can be expensive. Start with N_RUNS=1 to test before scaling up.\n"]}],"source":["\n","!pip install --upgrade openai pandas matplotlib numpy\n","\n","import os\n","import csv\n","import json\n","import re\n","import time\n","import uuid\n","import math\n","import statistics\n","import random\n","import argparse\n","from datetime import datetime\n","from typing import List, Dict, Any, Optional, Tuple\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","from openai import OpenAI\n","\n","#Configs\n","OUTPUT_DIR = \"benchmark_output\"\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","DEFAULT_MODELS = [\"gpt-4o\", \"gpt-5-mini\"]   # change to what you have access to\n","N_RUNS = 10                 # per model per scenario (increase for better stats)\n","TEMPERATURE = 0.2\n","MAX_TOKENS = 500\n","MAX_TURNS = 4               # allow some multi-turn back-and-forth\n","RANDOM_SEED = 12345         # used for local deterministic behavior (not model)\n","PLOT = True                 # save plots\n","LATEX_TABLE_FILE = os.path.join(OUTPUT_DIR, \"table_latex.txt\")\n","\n","# Cost note:\n","print(\"NOTE: Running many runs with GPT-5 can be expensive. Start with N_RUNS=1 to test before scaling up.\")\n","\n","# ------------------------------\n","# Helper utilities\n","# ------------------------------\n","def now_iso():\n","    return datetime.now().isoformat()\n","\n","def save_json(obj, fp):\n","    with open(fp, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(obj, f, indent=2, ensure_ascii=False)\n","\n","def ensure_output_dir():\n","    os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","def mean_ci95(values: List[float]) -> Tuple[float,float]:\n","    if not values:\n","        return 0.0, 0.0\n","    m = statistics.mean(values)\n","    if len(values) > 1:\n","        sd = statistics.stdev(values)\n","        ci95 = 1.96 * (sd / math.sqrt(len(values)))\n","    else:\n","        sd = 0.0\n","        ci95 = 0.0\n","    return m, ci95\n","\n","# balanced JSON extraction\n","def find_first_json_object(text: str) -> Optional[str]:\n","    start, depth = None, 0\n","    for i,ch in enumerate(text):\n","        if ch == \"{\":\n","            if start is None:\n","                start = i\n","            depth += 1\n","        elif ch == \"}\" and start is not None:\n","            depth -= 1\n","            if depth == 0:\n","                return text[start:i+1]\n","    return None\n","\n","def extract_json_block_from_fenced(text: str) -> Optional[str]:\n","    m = re.search(r'```json\\s*(\\{.*?\\})\\s*```', text, flags=re.DOTALL|re.IGNORECASE)\n","    if m: return m.group(1)\n","    m2 = re.search(r'```\\s*(\\{.*?\\})\\s*```', text, flags=re.DOTALL)\n","    if m2: return m2.group(1)\n","    return None\n","\n","def try_load_json(s: str) -> Optional[Dict[str,Any]]:\n","    try:\n","        return json.loads(s)\n","    except Exception:\n","        try:\n","            return json.loads(s.replace(\"'\", '\"'))\n","        except Exception:\n","            return None\n","\n","# very small parser for numbers in text\n","NUMBER_WORDS = {\"one\":1,\"two\":2,\"three\":3,\"four\":4,\"five\":5,\"six\":6,\"seven\":7}\n","def extract_number_from_text(text: str) -> Optional[int]:\n","    m = re.search(r'\\b([1-9][0-9]?)\\b', text)\n","    if m:\n","        try:\n","            return int(m.group(1))\n","        except:\n","            pass\n","    for w,val in NUMBER_WORDS.items():\n","        if re.search(r'\\b' + re.escape(w) + r'\\b', text, flags=re.IGNORECASE):\n","            return val\n","    return None\n","\n","# ------------------------------\n","# Tool detection/parsing & mock tool\n","# ------------------------------\n","def detect_and_parse_tool_call(text: str) -> Tuple[bool, Optional[Dict[str,Any]], Optional[str]]:\n","    if not text: return False, None, None\n","    jf = extract_json_block_from_fenced(text)\n","    if jf:\n","        parsed = try_load_json(jf)\n","        return True, parsed, None if parsed else \"failed_parse_fenced\"\n","    j = find_first_json_object(text)\n","    if j:\n","        parsed = try_load_json(j)\n","        return True, parsed, None if parsed else \"failed_parse_inline\"\n","    if re.search(r'\\b(reservation confirmed|booking confirmed|i have booked|i booked|confirmation id)\\b', text, flags=re.IGNORECASE):\n","        return True, {\"implied\": True, \"text\": text}, None\n","    return False, None, None\n","\n","def mock_book_table(params: Dict[str,Any]) -> Dict[str,Any]:\n","    # best-effort choices\n","    cuisine = params.get(\"cuisine\") or params.get(\"food\") or \"Restaurant\"\n","    city = params.get(\"city\") or \"City\"\n","    people = params.get(\"people\") or params.get(\"party_size\") or \"unknown\"\n","    time_ = params.get(\"time\") or params.get(\"date\") or \"\"\n","    restaurant_name = f\"{str(cuisine).title()} Place in {str(city).title()}\"\n","    confirmation = str(uuid.uuid4())[:12].upper()\n","    return {\n","        \"status\":\"confirmed\",\n","        \"restaurant\":restaurant_name,\n","        \"confirmation_id\":confirmation,\n","        \"details\":{\"cuisine\":cuisine, \"city\":city, \"people\":people, \"time\":time_},\n","        \"timestamp\": now_iso()\n","    }\n","\n","# ------------------------------\n","# Scoring rubric 0-20\n","# ------------------------------\n","def contains_city(text: str, expected_city: Optional[str]) -> bool:\n","    if not expected_city: return False\n","    return expected_city.lower() in text.lower()\n","\n","def contains_cuisine(text: str, expected_cuisine: Optional[str]) -> bool:\n","    if not expected_cuisine: return False\n","    t = text.lower(); c = expected_cuisine.lower()\n","    if c in t: return True\n","    synonyms = {\"sushi\":[\"japanese\"], \"japanese\":[\"sushi\"], \"vegan\":[\"plant-based\"]}\n","    for s in synonyms.get(c, []):\n","        if s in t: return True\n","    return False\n","\n","def contains_time(text: str, expected_time: Optional[str]) -> bool:\n","    if not expected_time: return False\n","    if expected_time.lower() in text.lower(): return True\n","    digits = re.findall(r'\\d{1,2}:\\d{2}|\\d{1,2}', expected_time)\n","    for d in digits:\n","        if re.search(r'\\b' + re.escape(d) + r'\\b', text):\n","            return True\n","    return False\n","\n","def contains_day(text: str, expected_day: Optional[str]) -> bool:\n","    if not expected_day: return False\n","    return expected_day.lower() in text.lower()\n","\n","def score_response(final_text: str, expected: Dict[str,Any], tool_flag: bool, tool_response: Optional[Dict[str,Any]]) -> Tuple[int, Dict[str,int]]:\n","    tl = (final_text or \"\").lower()\n","    b = {\"intent\":0,\"parameters\":0,\"tool\":0,\"structure\":0}\n","\n","    # Intent\n","    if re.search(r'\\b(book|reserve|reservation|booking|table)\\b', tl): b[\"intent\"] += 2\n","    if contains_cuisine(tl, expected.get(\"cuisine\")): b[\"intent\"] += 1\n","    if extract_number_from_text(tl): b[\"intent\"] += 1\n","    if re.search(r'\\b(i will|i\\'ll|i have booked|confirmed|confirmed)\\b', tl): b[\"intent\"] += 1\n","\n","    # Parameters (people, cuisine, city, day, time)\n","    p = 0\n","    if expected.get(\"people\"):\n","        if str(expected[\"people\"]) in tl or any(word for word,val in NUMBER_WORDS.items() if val==expected[\"people\"] and word in tl): p+=1\n","    if expected.get(\"cuisine\") and contains_cuisine(tl, expected[\"cuisine\"]): p+=1\n","    if expected.get(\"city\") and contains_city(tl, expected[\"city\"]): p+=1\n","    if expected.get(\"day\") and contains_day(tl, expected[\"day\"]): p+=1\n","    if expected.get(\"time\") and contains_time(tl, expected[\"time\"]): p+=1\n","    b[\"parameters\"] = p\n","\n","    # Tool usage\n","    if tool_flag:\n","        if tool_response and tool_response.get(\"status\") == \"confirmed\": b[\"tool\"] = 5\n","        else: b[\"tool\"] = 3\n","    else:\n","        b[\"tool\"] = 0\n","\n","    # Structure & actionability\n","    s=0\n","    if re.search(r'\\b(reservation|confirmed|confirmation|booked)\\b', tl): s+=2\n","    if re.search(r'(people:|party size:|time:|date:|restaurant:|confirmation:)', final_text, flags=re.IGNORECASE): s+=1\n","    if re.search(r'\\b(phone|email|contact)\\b', tl): s+=1\n","    if expected.get(\"city\") and expected.get(\"time\") and expected.get(\"people\") and expected[\"city\"].lower() in tl and str(expected[\"people\"]) in tl and re.search(r'\\d{1,2}(:\\d{2})?\\s*(am|pm)?', tl): s+=1\n","    b[\"structure\"] = min(s,5)\n","\n","    total = sum(b.values()); total = max(0, min(20, total))\n","    return total, b\n","\n","# ------------------------------\n","# OpenAI wrapper w/ retry & latency\n","# ------------------------------\n","def openai_chat_with_retry(client: OpenAI, model: str, messages: List[Dict[str,str]], temperature: float, max_tokens: int, retries:int=3, backoff:float=1.0):\n","    attempt = 0\n","    last_exc = None\n","    while attempt < retries:\n","        try:\n","            t0 = time.time()\n","            resp = client.chat.completions.create(model=model, messages=messages, temperature=temperature, max_tokens=max_tokens)\n","            latency = time.time() - t0\n","            return resp, latency, None\n","        except Exception as e:\n","            last_exc = e\n","            attempt += 1\n","            time.sleep(backoff * attempt)\n","    return None, None, last_exc\n","\n","# ------------------------------\n","# Simulated user replies (for clarifying Qs)\n","# ------------------------------\n","def simulate_user_response(user_prompt: str, scenario_expected: Dict[str,Any], assistant_text: str) -> Optional[str]:\n","    \"\"\"\n","    If assistant asks clarifying Qs, produce short answers based on expected scenario fields.\n","    Checks for keywords: party size, time, date, city, cuisine, dietary.\n","    \"\"\"\n","    at = assistant_text.lower()\n","    if re.search(r'\\b(how many|party size|how many people|number of people)\\b', at):\n","        return f\"{scenario_expected.get('people')}\"\n","    if re.search(r'\\b(what time|when is|what date|which day)\\b', at):\n","        dt = scenario_expected.get(\"day\") or scenario_expected.get(\"time\") or \"\"\n","        return f\"{dt}\"\n","    if re.search(r'\\b(what city|which city|where)\\b', at):\n","        return scenario_expected.get(\"city\", \"\")\n","    if re.search(r'\\b(cuisine|what kind of|which cuisine)\\b', at):\n","        return scenario_expected.get(\"cuisine\", \"\")\n","    # generic fallback: no answer -> None\n","    return None\n","\n","# ------------------------------\n","# Single scenario run (multi-turn)\n","# ------------------------------\n","def run_single_scenario(client: OpenAI, model: str, scenario_text: str, expected: Dict[str,Any],\n","                        temperature: float, max_tokens: int, max_turns: int, run_id: int, seed:int) -> Dict[str,Any]:\n","    system_prompt = (\n","        \"You are an assistant that handles restaurant reservations. If you need to call a booking tool, respond with a JSON \"\n","        \"object inside a ```json``` code block of the form: {\\\"action\\\":\\\"call_tool\\\", \\\"tool\\\":\\\"book_table\\\", \\\"params\\\":{...}} \"\n","        \"Otherwise you may ask clarifying questions. If you call the tool, wait for the tool result and then confirm back.\"\n","    )\n","    messages = [{\"role\":\"system\",\"content\":system_prompt}, {\"role\":\"user\",\"content\":scenario_text}]\n","    assistant_history = []\n","    latencies = []\n","    tool_called=False; tool_json=None; tool_parse_err=None; tool_response=None\n","\n","    for turn in range(max_turns):\n","        resp, latency, err = openai_chat_with_retry(client, model, messages, temperature, max_tokens)\n","        if err:\n","            return {\"error\": str(err)}\n","        latencies.append(latency)\n","        try:\n","            assistant_text = resp.choices[0].message.content.strip()\n","        except Exception:\n","            assistant_text = \"\"\n","        assistant_history.append(assistant_text)\n","\n","        # detect tool\n","        called, parsed, parse_err = detect_and_parse_tool_call(assistant_text)\n","        if called:\n","            tool_called = True\n","            tool_json = parsed\n","            tool_parse_err = parse_err\n","            # if parsed structured json with params -> invoke mock tool\n","            if isinstance(parsed, dict) and (parsed.get(\"action\") or parsed.get(\"tool\") or parsed.get(\"params\") or parsed.get(\"implied\")):\n","                params = parsed.get(\"params\") if isinstance(parsed.get(\"params\"), dict) else {}\n","                # fallback fill from expected\n","                if not params:\n","                    params = {\"people\": expected.get(\"people\"), \"cuisine\": expected.get(\"cuisine\"),\n","                              \"city\": expected.get(\"city\"), \"time\": expected.get(\"time\"), \"day\": expected.get(\"day\")}\n","                tool_response = mock_book_table(params)\n","                # Append tool response into conversation for the assistant to see\n","                messages.append({\"role\":\"assistant\",\"content\":assistant_text})\n","                messages.append({\"role\":\"system\",\"content\":\"TOOL_RESPONSE: \" + json.dumps(tool_response)})\n","                # let model confirm on next turn\n","                continue\n","            else:\n","                # implied booking in text, stop\n","                messages.append({\"role\":\"assistant\",\"content\":assistant_text})\n","                break\n","        else:\n","            # no tool\n","            messages.append({\"role\":\"assistant\",\"content\":assistant_text})\n","            # if assistant asks clarifying question, simulate user answer using expected\n","            user_reply = simulate_user_response(\"\", expected, assistant_text)\n","            if user_reply:\n","                messages.append({\"role\":\"user\",\"content\":user_reply})\n","                # continue to next turn so model can act on it\n","                continue\n","            # if assistant claimed booking, stop\n","            if re.search(r'\\b(reservation confirmed|booking confirmed|i have booked|i booked|confirmation id)\\b', assistant_text, flags=re.IGNORECASE):\n","                break\n","            # otherwise let it have another turn (up to max_turns)\n","            continue\n","\n","    final_text = \"\\n\\n\".join(assistant_history)\n","    return {\n","        \"final_text\": final_text,\n","        \"assistant_history\": assistant_history,\n","        \"latencies\": latencies,\n","        \"tool_called\": tool_called,\n","        \"tool_json\": tool_json,\n","        \"tool_parse_err\": tool_parse_err,\n","        \"tool_response\": tool_response\n","    }\n","\n","# ------------------------------\n","# Top-level runner\n","# ------------------------------\n","def run_benchmark(client: OpenAI, models: List[str], scenarios: List[Dict[str,Any]], n_runs:int,\n","                  temperature:float, max_tokens:int, max_turns:int, seed:int):\n","    random.seed(seed); np.random.seed(seed)\n","    ensure_output_dir()\n","    timestamp = now_iso()\n","    all_rows = []\n","    summary = {}\n","\n","    for model in models:\n","        print(f\"\\n--- Model: {model} ---\")\n","        for run_idx in range(1, n_runs+1):\n","            print(f\"Run {run_idx}/{n_runs}\")\n","            for scen in scenarios:\n","                sid = scen.get(\"id\", str(uuid.uuid4())[:8])\n","                text = scen[\"text\"]\n","                expected = scen.get(\"expected\", {})\n","                res = run_single_scenario(client, model, text, expected, temperature, max_tokens, max_turns, run_idx, seed)\n","                if res.get(\"error\"):\n","                    print(\"Error for scenario\", sid, res[\"error\"])\n","                    continue\n","                final_text = res[\"final_text\"]\n","                tool_flag = res[\"tool_called\"]\n","                tool_json = res[\"tool_json\"]\n","                tool_resp = res[\"tool_response\"]\n","                latencies = res[\"latencies\"]\n","                latency_mean = statistics.mean(latencies) if latencies else None\n","\n","                total_score, breakdown = score_response(final_text, expected, tool_flag, tool_resp)\n","                row = {\n","                    \"timestamp\": timestamp,\n","                    \"model\": model,\n","                    \"run_idx\": run_idx,\n","                    \"scenario_id\": sid,\n","                    \"scenario_text\": text,\n","                    \"expected\": json.dumps(expected, ensure_ascii=False),\n","                    \"final_text\": final_text,\n","                    \"total_score\": total_score,\n","                    \"intent_score\": breakdown[\"intent\"],\n","                    \"parameters_score\": breakdown[\"parameters\"],\n","                    \"tool_score\": breakdown[\"tool\"],\n","                    \"structure_score\": breakdown[\"structure\"],\n","                    \"tool_called\": tool_flag,\n","                    \"tool_json\": json.dumps(tool_json, ensure_ascii=False) if tool_json else \"\",\n","                    \"tool_parse_err\": res.get(\"tool_parse_err\"),\n","                    \"tool_response\": json.dumps(tool_resp, ensure_ascii=False) if tool_resp else \"\",\n","                    \"latency_mean_s\": latency_mean,\n","                    \"n_api_calls\": len(latencies),\n","                    \"temperature\": temperature,\n","                    \"max_tokens\": max_tokens\n","                }\n","                all_rows.append(row)\n","                # aggregate\n","                key = (model, sid)\n","                summary.setdefault(key, []).append(total_score)\n","                print(f\"Scenario {sid} | Score {total_score}/20 | tool_called: {tool_flag} | latency: {latency_mean}\")\n","\n","    # Save detailed CSV\n","    df = pd.DataFrame(all_rows)\n","    detailed_csv = os.path.join(OUTPUT_DIR, \"detailed_results.csv\")\n","    df.to_csv(detailed_csv, index=False)\n","    print(\"Detailed results saved to\", detailed_csv)\n","\n","    # Aggregated summary\n","    summary_rows=[]\n","    for (model, sid), scores in summary.items():\n","        mean, ci95 = mean_ci95(scores)\n","        stdev = statistics.stdev(scores) if len(scores)>1 else 0.0\n","        summary_rows.append({\"model\":model,\"scenario_id\":sid,\"n_runs\":len(scores),\"mean_score\":mean,\"std_dev\":stdev,\"ci95\":ci95,\"min\":min(scores),\"max\":max(scores)})\n","    summary_df = pd.DataFrame(summary_rows)\n","    summary_csv = os.path.join(OUTPUT_DIR, \"summary_results.csv\")\n","    summary_df.to_csv(summary_csv, index=False)\n","    print(\"Summary saved to\", summary_csv)\n","\n","    # Save JSON\n","    save_json({\"detailed_count\": len(all_rows), \"summary\": summary_rows, \"generated_at\": timestamp}, os.path.join(OUTPUT_DIR, \"summary.json\"))\n","\n","    # Plot per-model boxplot & means\n","    if PLOT and not summary_df.empty:\n","        plt.figure(figsize=(10,6))\n","        # boxplot from detailed df\n","        df.boxplot(column=\"total_score\", by=\"model\", grid=False)\n","        plt.title(\"Score distribution by model\")\n","        plt.suptitle(\"\")\n","        plt.ylabel(\"Total Score (0-20)\")\n","        plt.savefig(os.path.join(OUTPUT_DIR, \"score_boxplot_by_model.png\"))\n","        plt.close()\n","        print(\"Saved boxplot: score_boxplot_by_model.png\")\n","\n","        # mean bar with error bars\n","        g = summary_df.groupby(\"model\").agg({\"mean_score\":\"mean\", \"std_dev\":\"mean\"})\n","        plt.figure(figsize=(8,5))\n","        plt.bar(g.index, g[\"mean_score\"], yerr=g[\"std_dev\"], capsize=5)\n","        plt.ylabel(\"Mean Score\")\n","        plt.title(\"Mean score by model (error bars = mean std dev)\")\n","        plt.savefig(os.path.join(OUTPUT_DIR, \"mean_score_by_model.png\"))\n","        plt.close()\n","        print(\"Saved mean plot: mean_score_by_model.png\")\n","\n","    # LaTeX table output (simple)\n","    with open(LATEX_TABLE_FILE, \"w\", encoding=\"utf-8\") as f:\n","        f.write(\"% LaTeX table: model, scenario, n_runs, mean, std, ci95, min, max\\n\")\n","        f.write(\"\\\\begin{tabular}{l l r r r r r}\\n\")\n","        f.write(\"\\\\hline\\nModel & Scenario & n & mean & std & CI95 & min & max \\\\\\\\\\n\\\\hline\\n\")\n","        for r in summary_rows:\n","            f.write(f\"{r['model']} & {r['scenario_id']} & {r['n_runs']} & {r['mean_score']:.2f} & {r['std_dev']:.2f} & {r['ci95']:.2f} & {r['min']} & {r['max']} \\\\\\\\\\n\")\n","        f.write(\"\\\\hline\\n\\\\end{tabular}\\n\")\n","    print(\"LaTeX table written to\", LATEX_TABLE_FILE)\n","\n","    return {\"detailed_csv\": detailed_csv, \"summary_csv\": summary_csv, \"summary_json\": os.path.join(OUTPUT_DIR, \"summary.json\")}\n","\n","# ------------------------------\n","# Default scenarios (paper-ready)\n","# ------------------------------\n","DEFAULT_SCENARIOS = [\n","    {\"id\":\"s1\",\"text\":\"Book a table for 2 at an Italian restaurant in New York on Friday at 8 PM.\",\"expected\":{\"people\":2,\"cuisine\":\"italian\",\"city\":\"new york\",\"day\":\"friday\",\"time\":\"8 PM\"}},\n","    {\"id\":\"s2\",\"text\":\"Reserve a vegan restaurant for 6 people in Seattle next Wednesday at 6:45 PM.\",\"expected\":{\"people\":6,\"cuisine\":\"vegan\",\"city\":\"seattle\",\"day\":\"wednesday\",\"time\":\"6:45 PM\"}},\n","    {\"id\":\"s3\",\"text\":\"Find a sushi place in Los Angeles for 3 people tomorrow night at 7 PM.\",\"expected\":{\"people\":3,\"cuisine\":\"sushi\",\"city\":\"los angeles\",\"day\":\"tomorrow\",\"time\":\"7 PM\"}},\n","    {\"id\":\"s4\",\"text\":\"Book a Japanese restaurant in San Francisco for 4 people this Saturday at 7:30 PM.\",\"expected\":{\"people\":4,\"cuisine\":\"japanese\",\"city\":\"san francisco\",\"day\":\"saturday\",\"time\":\"7:30 PM\"}},\n","]\n","\n","# ------------------------------\n","# Run (Colab friendly)\n","# ------------------------------\n","# API key handling\n","api_key = os.environ.get(\"OPENAI_API_KEY\")\n","if not api_key:\n","    api_key = input(\"Enter your OpenAI API key (it will not be saved to disk): \").strip()\n","    os.environ[\"OPENAI_API_KEY\"] = api_key\n","\n","client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n","\n","# Run the benchmark\n","results = run_benchmark(client=client,\n","                        models=DEFAULT_MODELS,\n","                        scenarios=DEFAULT_SCENARIOS,\n","                        n_runs=N_RUNS,\n","                        temperature=TEMPERATURE,\n","                        max_tokens=MAX_TOKENS,\n","                        max_turns=MAX_TURNS,\n","                        seed=RANDOM_SEED)\n","\n","print(\"\\nDone. Outputs saved in\", OUTPUT_DIR)\n","print(\"Files:\", results)"]},{"cell_type":"code","source":["# ============================================================================\n","# RESEARCH-GRADE LONG-TRAJECTORY AGENTIC EXECUTION BENCHMARK\n","# ============================================================================\n","# This benchmark measures how well AI models perform multi-turn agent tasks\n","# with structured evaluation, statistical rigor, and reproducibility.\n","# Run in one Colab cell. Minimal iterations for initial testing/review.\n","# ============================================================================\n","\n","!pip install --upgrade openai pandas matplotlib numpy scipy\n","\n","import os, csv, json, re, time, uuid, math, statistics, random, argparse\n","from datetime import datetime\n","from typing import List, Dict, Any, Optional, Tuple\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from scipy import stats  # RESEARCH: for statistical significance testing\n","from openai import OpenAI\n","\n","#Configs\n","OUTPUT_DIR = \"benchmark_output\"\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","DEFAULT_MODELS = [\"gpt-4o-mini\"]  # Start with cheaper model for testing\n","N_RUNS = 3  # RESEARCH: Minimum 3 runs for CI calculation, increase to 10+ for publication\n","TEMPERATURE = 0.2\n","MAX_TOKENS = 500\n","MAX_TURNS = 4\n","RANDOM_SEED = 42  # reproducibility is critical for research\n","\n","# RESEARCH METADATA (required for paper)\n","BENCHMARK_VERSION = \"1.0\"\n","BENCHMARK_NAME = \"Long-Trajectory Agentic Execution (LTA-E)\"\n","RESEARCH_FOCUS = \"multi-turn agent performance on structured reservation tasks\"\n","\n","print(f\"Benchmark: {BENCHMARK_NAME} v{BENCHMARK_VERSION}\")\n","print(f\"Focus: {RESEARCH_FOCUS}\")\n","print(f\"Runs per scenario: {N_RUNS} (increase for publication)\")\n","\n","# ============================================================================\n","# UTILITIES\n","# ============================================================================\n","def now_iso():\n","    return datetime.now().isoformat()\n","\n","def save_json(obj, fp):\n","    with open(fp, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(obj, f, indent=2, ensure_ascii=False)\n","\n","def mean_ci95(values: List[float]) -> Tuple[float, float, float]:\n","    \"\"\"Calculate mean, 95% CI, and standard error for research reporting.\"\"\"\n","    if not values:\n","        return 0.0, 0.0, 0.0\n","    m = statistics.mean(values)\n","    if len(values) > 1:\n","        sd = statistics.stdev(values)\n","        se = sd / math.sqrt(len(values))  # standard error\n","        ci95 = 1.96 * se\n","    else:\n","        sd = 0.0\n","        se = 0.0\n","        ci95 = 0.0\n","    return m, ci95, se\n","\n","def find_first_json_object(text: str) -> Optional[str]:\n","    \"\"\"Robust JSON extraction from model output.\"\"\"\n","    start, depth = None, 0\n","    for i, ch in enumerate(text):\n","        if ch == \"{\":\n","            if start is None:\n","                start = i\n","            depth += 1\n","        elif ch == \"}\" and start is not None:\n","            depth -= 1\n","            if depth == 0:\n","                return text[start:i+1]\n","    return None\n","\n","def extract_json_block_from_fenced(text: str) -> Optional[str]:\n","    \"\"\"Extract JSON from ```json``` code blocks.\"\"\"\n","    m = re.search(r'```json\\s*(\\{.*?\\})\\s*```', text, flags=re.DOTALL|re.IGNORECASE)\n","    if m: return m.group(1)\n","    m2 = re.search(r'```\\s*(\\{.*?\\})\\s*```', text, flags=re.DOTALL)\n","    if m2: return m2.group(1)\n","    return None\n","\n","def try_load_json(s: str) -> Optional[Dict[str,Any]]:\n","    \"\"\"Attempt JSON parsing with fallback.\"\"\"\n","    try:\n","        return json.loads(s)\n","    except Exception:\n","        try:\n","            return json.loads(s.replace(\"'\", '\"'))\n","        except Exception:\n","            return None\n","\n","NUMBER_WORDS = {\"one\":1,\"two\":2,\"three\":3,\"four\":4,\"five\":5,\"six\":6,\"seven\":7}\n","def extract_number_from_text(text: str) -> Optional[int]:\n","    \"\"\"Extract party size from text.\"\"\"\n","    m = re.search(r'\\b([1-9][0-9]?)\\b', text)\n","    if m:\n","        try:\n","            return int(m.group(1))\n","        except:\n","            pass\n","    for w, val in NUMBER_WORDS.items():\n","        if re.search(r'\\b' + re.escape(w) + r'\\b', text, flags=re.IGNORECASE):\n","            return val\n","    return None\n","\n","# ============================================================================\n","# TOOL DETECTION & MOCK TOOL EXECUTION\n","# ============================================================================\n","def detect_and_parse_tool_call(text: str) -> Tuple[bool, Optional[Dict[str,Any]], Optional[str]]:\n","    \"\"\"RESEARCH: Detect if model attempted tool use and extract parameters.\"\"\"\n","    if not text: return False, None, None\n","    jf = extract_json_block_from_fenced(text)\n","    if jf:\n","        parsed = try_load_json(jf)\n","        return True, parsed, None if parsed else \"failed_parse_fenced\"\n","    j = find_first_json_object(text)\n","    if j:\n","        parsed = try_load_json(j)\n","        return True, parsed, None if parsed else \"failed_parse_inline\"\n","    if re.search(r'\\b(reservation confirmed|booking confirmed|i have booked|i booked|confirmation id)\\b', text, flags=re.IGNORECASE):\n","        return True, {\"implied\": True, \"text\": text}, None\n","    return False, None, None\n","\n","def mock_book_table(params: Dict[str,Any]) -> Dict[str,Any]:\n","    \"\"\"RESEARCH: Mock tool that returns structured confirmation.\"\"\"\n","    cuisine = params.get(\"cuisine\") or params.get(\"food\") or \"Restaurant\"\n","    city = params.get(\"city\") or \"City\"\n","    people = params.get(\"people\") or params.get(\"party_size\") or \"unknown\"\n","    time_ = params.get(\"time\") or params.get(\"date\") or \"\"\n","    restaurant_name = f\"{str(cuisine).title()} Place in {str(city).title()}\"\n","    confirmation = str(uuid.uuid4())[:12].upper()\n","    return {\n","        \"status\": \"confirmed\",\n","        \"restaurant\": restaurant_name,\n","        \"confirmation_id\": confirmation,\n","        \"details\": {\"cuisine\": cuisine, \"city\": city, \"people\": people, \"time\": time_},\n","        \"timestamp\": now_iso()\n","    }\n","\n","# ============================================================================\n","# SCORING RUBRIC (0-20): RESEARCH-GRADE EVALUATION\n","# ============================================================================\n","# RESEARCH NOTE: This rubric must be clearly defined, defensible, and reported in paper.\n","# Each component measures a distinct aspect of agent behavior.\n","\n","def contains_city(text: str, expected_city: Optional[str]) -> bool:\n","    \"\"\"Check if response mentions the correct city.\"\"\"\n","    if not expected_city: return False\n","    return expected_city.lower() in text.lower()\n","\n","def contains_cuisine(text: str, expected_cuisine: Optional[str]) -> bool:\n","    \"\"\"Check if response mentions correct cuisine with synonym support.\"\"\"\n","    if not expected_cuisine: return False\n","    t = text.lower(); c = expected_cuisine.lower()\n","    if c in t: return True\n","    synonyms = {\"sushi\":[\"japanese\"],\"japanese\":[\"sushi\"],\"vegan\":[\"plant-based\"]}\n","    for s in synonyms.get(c, []):\n","        if s in t: return True\n","    return False\n","\n","def contains_time(text: str, expected_time: Optional[str]) -> bool:\n","    \"\"\"Check if response mentions correct reservation time.\"\"\"\n","    if not expected_time: return False\n","    if expected_time.lower() in text.lower(): return True\n","    digits = re.findall(r'\\d{1,2}:\\d{2}|\\d{1,2}', expected_time)\n","    for d in digits:\n","        if re.search(r'\\b' + re.escape(d) + r'\\b', text):\n","            return True\n","    return False\n","\n","def contains_day(text: str, expected_day: Optional[str]) -> bool:\n","    \"\"\"Check if response mentions correct day.\"\"\"\n","    if not expected_day: return False\n","    return expected_day.lower() in text.lower()\n","\n","def score_response(final_text: str, expected: Dict[str,Any], tool_flag: bool, tool_response: Optional[Dict[str,Any]]) -> Tuple[int, Dict[str,int]]:\n","    \"\"\"\n","    RESEARCH RUBRIC (0-20 total):\n","    - Intent Recognition (0-5): Did agent identify task as reservation request?\n","    - Parameter Extraction (0-5): Did agent capture all required fields?\n","    - Tool Execution (0-5): Did agent attempt/successfully call booking tool?\n","    - Response Quality (0-5): Is final response clear, actionable, and complete?\n","    \"\"\"\n","    tl = (final_text or \"\").lower()\n","    b = {\"intent\":0, \"parameters\":0, \"tool\":0, \"quality\":0}\n","\n","    # INTENT (0-5): Recognize reservation task\n","    if re.search(r'\\b(book|reserve|reservation|booking|table)\\b', tl): b[\"intent\"] += 2\n","    if contains_cuisine(tl, expected.get(\"cuisine\")): b[\"intent\"] += 1\n","    if extract_number_from_text(tl): b[\"intent\"] += 1\n","    if re.search(r'\\b(i will|i\\'ll|confirmed)\\b', tl): b[\"intent\"] += 1\n","\n","    # PARAMETERS (0-5): Extract required fields\n","    p = 0\n","    if expected.get(\"people\"):\n","        if str(expected[\"people\"]) in tl or any(word for word,val in NUMBER_WORDS.items() if val==expected[\"people\"] and word in tl): p+=1\n","    if expected.get(\"cuisine\") and contains_cuisine(tl, expected[\"cuisine\"]): p+=1\n","    if expected.get(\"city\") and contains_city(tl, expected[\"city\"]): p+=1\n","    if expected.get(\"day\") and contains_day(tl, expected[\"day\"]): p+=1\n","    if expected.get(\"time\") and contains_time(tl, expected[\"time\"]): p+=1\n","    b[\"parameters\"] = p\n","\n","    # TOOL EXECUTION (0-5): Attempt and success in calling tool\n","    if tool_flag:\n","        if tool_response and tool_response.get(\"status\") == \"confirmed\": b[\"tool\"] = 5\n","        else: b[\"tool\"] = 3\n","    else:\n","        b[\"tool\"] = 0\n","\n","    # RESPONSE QUALITY (0-5): Clear, actionable final response\n","    s = 0\n","    if re.search(r'\\b(reservation|confirmed|confirmation|booked)\\b', tl): s+=2\n","    if re.search(r'(people:|party size:|time:|date:|restaurant:|confirmation:)', final_text, flags=re.IGNORECASE): s+=1\n","    if re.search(r'\\b(phone|email|contact)\\b', tl): s+=1\n","    if expected.get(\"city\") and expected.get(\"time\") and expected.get(\"people\") and expected[\"city\"].lower() in tl and str(expected[\"people\"]) in tl and re.search(r'\\d{1,2}(:\\d{2})?\\s*(am|pm)?', tl): s+=1\n","    b[\"quality\"] = min(s, 5)\n","\n","    total = sum(b.values())\n","    total = max(0, min(20, total))\n","    return total, b\n","\n","# ============================================================================\n","# OPENAI API WRAPPER WITH RETRY LOGIC\n","# ============================================================================\n","def openai_chat_with_retry(client: OpenAI, model: str, messages: List[Dict[str,str]],\n","                           temperature: float, max_tokens: int, retries:int=3, backoff:float=1.0):\n","    \"\"\"RESEARCH: Robust API calling with latency tracking and error handling.\"\"\"\n","    attempt = 0\n","    last_exc = None\n","    while attempt < retries:\n","        try:\n","            t0 = time.time()\n","            resp = client.chat.completions.create(model=model, messages=messages,\n","                                                   temperature=temperature, max_tokens=max_tokens)\n","            latency = time.time() - t0\n","            return resp, latency, None\n","        except Exception as e:\n","            last_exc = e\n","            attempt += 1\n","            if attempt < retries:\n","                time.sleep(backoff * attempt)\n","    return None, None, last_exc\n","\n","# ============================================================================\n","# MULTI-TURN AGENT EXECUTION\n","# ============================================================================\n","def run_single_scenario(client: OpenAI, model: str, scenario_text: str, expected: Dict[str,Any],\n","                        temperature: float, max_tokens: int, max_turns: int, run_id: int, seed: int) -> Dict[str,Any]:\n","    \"\"\"\n","    RESEARCH: Execute a single long-trajectory scenario with multi-turn agent logic.\n","    - Tracks all turns, tool calls, and latencies\n","    - Simulates user responses to clarifying questions\n","    - Records complete trajectory for analysis\n","    \"\"\"\n","    system_prompt = (\n","        \"You are an assistant that handles restaurant reservations. If you need to call a booking tool, respond with a JSON \"\n","        \"object inside a ```json``` code block of the form: {\\\"action\\\":\\\"call_tool\\\", \\\"tool\\\":\\\"book_table\\\", \\\"params\\\":{...}} \"\n","        \"Otherwise you may ask clarifying questions. If you call the tool, wait for the tool result and then confirm back.\"\n","    )\n","    messages = [{\"role\":\"system\", \"content\":system_prompt}, {\"role\":\"user\", \"content\":scenario_text}]\n","    assistant_history = []\n","    latencies = []\n","    tool_called = False\n","    tool_json = None\n","    tool_parse_err = None\n","    tool_response = None\n","    turn_count = 0\n","\n","    for turn in range(max_turns):\n","        turn_count += 1\n","        resp, latency, err = openai_chat_with_retry(client, model, messages, temperature, max_tokens)\n","\n","        if err:\n","            return {\"error\": str(err), \"turn_failed\": turn_count}\n","\n","        latencies.append(latency)\n","\n","        try:\n","            assistant_text = resp.choices[0].message.content.strip()\n","        except Exception:\n","            assistant_text = \"\"\n","\n","        assistant_history.append(assistant_text)\n","\n","        # Detect if model attempted tool use\n","        called, parsed, parse_err = detect_and_parse_tool_call(assistant_text)\n","\n","        if called:\n","            tool_called = True\n","            tool_json = parsed\n","            tool_parse_err = parse_err\n","\n","            # If valid tool call, execute mock tool\n","            if isinstance(parsed, dict) and (parsed.get(\"action\") or parsed.get(\"tool\") or parsed.get(\"params\") or parsed.get(\"implied\")):\n","                params = parsed.get(\"params\") if isinstance(parsed.get(\"params\"), dict) else {}\n","\n","                # Fallback: fill missing params from expected scenario\n","                if not params:\n","                    params = {\"people\": expected.get(\"people\"), \"cuisine\": expected.get(\"cuisine\"),\n","                              \"city\": expected.get(\"city\"), \"time\": expected.get(\"time\"), \"day\": expected.get(\"day\")}\n","\n","                tool_response = mock_book_table(params)\n","\n","                # Continue conversation with tool response\n","                messages.append({\"role\":\"assistant\", \"content\":assistant_text})\n","                messages.append({\"role\":\"system\", \"content\":\"TOOL_RESPONSE: \" + json.dumps(tool_response)})\n","                continue\n","            else:\n","                # Implied booking in text, stop trajectory\n","                messages.append({\"role\":\"assistant\", \"content\":assistant_text})\n","                break\n","        else:\n","            # No tool call detected\n","            messages.append({\"role\":\"assistant\", \"content\":assistant_text})\n","\n","            # Simulate user response if model asks clarifying question\n","            if re.search(r'\\b(how many|party size|what time|when is|what city|which cuisine)\\b', assistant_text, flags=re.IGNORECASE):\n","                if re.search(r'\\b(how many|party size|how many people|number of people)\\b', assistant_text.lower()):\n","                    user_reply = f\"{expected.get('people')}\"\n","                elif re.search(r'\\b(what time|when is|what date|which day)\\b', assistant_text.lower()):\n","                    user_reply = f\"{expected.get('day') or expected.get('time') or ''}\"\n","                elif re.search(r'\\b(what city|which city|where)\\b', assistant_text.lower()):\n","                    user_reply = expected.get(\"city\", \"\")\n","                elif re.search(r'\\b(cuisine|what kind of|which cuisine)\\b', assistant_text.lower()):\n","                    user_reply = expected.get(\"cuisine\", \"\")\n","                else:\n","                    user_reply = None\n","\n","                if user_reply:\n","                    messages.append({\"role\":\"user\", \"content\":user_reply})\n","                    continue\n","\n","            # Check if task is complete\n","            if re.search(r'\\b(reservation confirmed|booking confirmed|i have booked|i booked|confirmation id)\\b', assistant_text, flags=re.IGNORECASE):\n","                break\n","\n","            # Otherwise continue multi-turn dialogue\n","\n","    final_text = \"\\n\\n\".join(assistant_history)\n","\n","    return {\n","        \"final_text\": final_text,\n","        \"assistant_history\": assistant_history,\n","        \"latencies\": latencies,\n","        \"tool_called\": tool_called,\n","        \"tool_json\": tool_json,\n","        \"tool_parse_err\": tool_parse_err,\n","        \"tool_response\": tool_response,\n","        \"turn_count\": turn_count\n","    }\n","\n","# ============================================================================\n","# ADVANCED METRICS FOR RESEARCH PAPERS\n","# ============================================================================\n","def calculate_pass_at_k(scores: List[int], threshold: int = 15) -> float:\n","    \"\"\"\n","    RESEARCH: pass@k metric - what % of runs succeeded?\n","    Critical for papers: measures CONSISTENCY not just single attempts.\n","    Literature: Used by τ-Bench and Anthropic's Claude evaluations.\n","    \"\"\"\n","    if not scores:\n","        return 0.0\n","    pass_count = sum(1 for s in scores if s >= threshold)\n","    return pass_count / len(scores)\n","\n","def calculate_cost_efficiency(latencies: List[float], token_counts: List[int], model: str, scores: List[int]) -> Dict[str, float]:\n","    \"\"\"\n","    RESEARCH: Cost-quality tradeoff analysis.\n","    Literature: AI Agents That Matter (Princeton) emphasizes cost must be measured.\n","    Returns: cost_per_success, tokens_per_success, latency_per_success\n","    \"\"\"\n","    if not latencies or not scores:\n","        return {\"cost_efficiency\": 0.0, \"avg_latency\": 0.0, \"tokens_per_score\": 0.0}\n","\n","    total_latency = sum(latencies)\n","    avg_latency = total_latency / len(latencies)\n","    avg_tokens = sum(token_counts) / len(token_counts) if token_counts else 0\n","    avg_score = sum(scores) / len(scores)\n","\n","    # Rough cost model (update with real pricing)\n","    cost_per_1m_tokens = 3.0  # gpt-4o-mini approximate\n","    total_cost = (sum(token_counts) / 1_000_000) * cost_per_1m_tokens\n","\n","    return {\n","        \"total_cost_usd\": round(total_cost, 4),\n","        \"cost_per_successful_task\": round(total_cost / (avg_score + 0.01), 4),\n","        \"avg_latency_s\": round(avg_latency, 3),\n","        \"total_tokens\": sum(token_counts),\n","        \"tokens_per_turn\": round(avg_tokens / len(latencies), 0)\n","    }\n","\n","def calculate_trajectory_quality(assistant_history: List[str]) -> Dict[str, Any]:\n","    \"\"\"\n","    RESEARCH: Analyze quality of multi-turn trajectory.\n","    Measures: coherence decay, tool attempts, clarification questions.\n","    \"\"\"\n","    if not assistant_history:\n","        return {\"trajectory_turns\": 0, \"tool_attempts\": 0, \"clarifications\": 0}\n","\n","    tool_attempts = sum(1 for turn in assistant_history if \"{\" in turn and \"action\" in turn.lower())\n","    clarifications = sum(1 for turn in assistant_history if \"?\" in turn and len(turn) < 200)\n","\n","    return {\n","        \"trajectory_turns\": len(assistant_history),\n","        \"tool_attempts\": tool_attempts,\n","        \"clarification_turns\": clarifications,\n","        \"avg_turn_length\": round(sum(len(t) for t in assistant_history) / len(assistant_history), 0)\n","    }\n","\n","# ============================================================================\n","# MAIN BENCHMARK RUNNER\n","# ============================================================================\n","def run_benchmark(client: OpenAI, models: List[str], scenarios: List[Dict[str,Any]],\n","                  n_runs: int, temperature: float, max_tokens: int, max_turns: int, seed: int):\n","    \"\"\"\n","    RESEARCH: Execute full benchmark with statistical analysis.\n","    Outputs: detailed CSV, summary stats, plots, LaTeX tables, cost analysis.\n","    Includes pass@k, trajectory analysis, and cost-efficiency metrics.\n","    \"\"\"\n","    random.seed(seed)\n","    np.random.seed(seed)\n","    os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","    timestamp = now_iso()\n","    all_rows = []\n","    summary = {}\n","    trajectory_data = {}  # RESEARCH: Track multi-turn patterns\n","    cost_analysis = {}    # RESEARCH: Track cost-quality tradeoffs\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"BENCHMARK: {BENCHMARK_NAME}\")\n","    print(f\"Version: {BENCHMARK_VERSION} | Runs: {n_runs} | Seed: {seed}\")\n","    print(f\"{'='*70}\\n\")\n","\n","    for model in models:\n","        print(f\"\\n--- Model: {model} ---\")\n","        for run_idx in range(1, n_runs + 1):\n","            print(f\"  Run {run_idx}/{n_runs}\")\n","            for scen in scenarios:\n","                sid = scen.get(\"id\", str(uuid.uuid4())[:8])\n","                text = scen[\"text\"]\n","                expected = scen.get(\"expected\", {})\n","\n","                res = run_single_scenario(client, model, text, expected, temperature,\n","                                         max_tokens, max_turns, run_idx, seed)\n","\n","                if res.get(\"error\"):\n","                    print(f\"    ERROR in scenario {sid}: {res['error']}\")\n","                    continue\n","\n","                final_text = res[\"final_text\"]\n","                tool_flag = res[\"tool_called\"]\n","                tool_json = res[\"tool_json\"]\n","                tool_resp = res[\"tool_response\"]\n","                latencies = res[\"latencies\"]\n","                turn_count = res[\"turn_count\"]\n","                latency_mean = statistics.mean(latencies) if latencies else None\n","\n","                total_score, breakdown = score_response(final_text, expected, tool_flag, tool_resp)\n","\n","                row = {\n","                    \"timestamp\": timestamp,\n","                    \"model\": model,\n","                    \"run_idx\": run_idx,\n","                    \"scenario_id\": sid,\n","                    \"scenario_text\": text,\n","                    \"expected\": json.dumps(expected, ensure_ascii=False),\n","                    \"final_text\": final_text,\n","                    \"total_score\": total_score,\n","                    \"intent_score\": breakdown[\"intent\"],\n","                    \"parameters_score\": breakdown[\"parameters\"],\n","                    \"tool_score\": breakdown[\"tool\"],\n","                    \"quality_score\": breakdown[\"quality\"],\n","                    \"tool_called\": tool_flag,\n","                    \"tool_json\": json.dumps(tool_json, ensure_ascii=False) if tool_json else \"\",\n","                    \"tool_parse_err\": res.get(\"tool_parse_err\"),\n","                    \"tool_response\": json.dumps(tool_resp, ensure_ascii=False) if tool_resp else \"\",\n","                    \"latency_mean_s\": latency_mean,\n","                    \"turn_count\": turn_count,\n","                    \"n_api_calls\": len(latencies),\n","                    \"temperature\": temperature,\n","                    \"max_tokens\": max_tokens\n","                }\n","                all_rows.append(row)\n","\n","                key = (model, sid)\n","                summary.setdefault(key, []).append(total_score)\n","\n","                # RESEARCH: Track trajectory quality and cost (new additions)\n","                traj_quality = calculate_trajectory_quality(res[\"assistant_history\"])\n","                if key not in trajectory_data:\n","                    trajectory_data[key] = []\n","                trajectory_data[key].append(traj_quality)\n","\n","                if key not in cost_analysis:\n","                    cost_analysis[key] = []\n","                cost_analysis[key].append({\n","                    \"latencies\": latencies,\n","                    \"score\": total_score,\n","                    \"turns\": turn_count\n","                })\n","\n","                print(f\"    Scenario {sid} | Score {total_score}/20 | Turns: {turn_count} | Tool: {tool_flag} | Latency: {latency_mean:.2f}s\")\n","\n","    # RESEARCH: Save detailed results\n","    df = pd.DataFrame(all_rows)\n","    detailed_csv = os.path.join(OUTPUT_DIR, \"detailed_results.csv\")\n","    df.to_csv(detailed_csv, index=False)\n","    print(f\"\\n✓ Detailed results: {detailed_csv}\")\n","\n","    # RESEARCH: Generate summary statistics with pass@k and cost analysis\n","    summary_rows = []\n","    for (model, sid), scores in summary.items():\n","        mean, ci95, se = mean_ci95(scores)\n","        stdev = statistics.stdev(scores) if len(scores) > 1 else 0.0\n","\n","        # RESEARCH: pass@k metric (% of runs meeting threshold)\n","        pass_at_15 = calculate_pass_at_k(scores, threshold=15)\n","        pass_at_10 = calculate_pass_at_k(scores, threshold=10)\n","\n","        summary_rows.append({\n","            \"model\": model,\n","            \"scenario_id\": sid,\n","            \"n_runs\": len(scores),\n","            \"mean_score\": round(mean, 2),\n","            \"std_dev\": round(stdev, 2),\n","            \"se\": round(se, 2),\n","            \"ci95_lower\": round(mean - ci95, 2),\n","            \"ci95_upper\": round(mean + ci95, 2),\n","            \"pass_at_10\": round(pass_at_10, 3),\n","            \"pass_at_15\": round(pass_at_15, 3),\n","            \"min\": min(scores),\n","            \"max\": max(scores)\n","        })\n","\n","    summary_df = pd.DataFrame(summary_rows)\n","    summary_csv = os.path.join(OUTPUT_DIR, \"summary_results.csv\")\n","    summary_df.to_csv(summary_csv, index=False)\n","    print(f\"✓ Summary statistics: {summary_csv}\")\n","\n","    # RESEARCH: Save metadata JSON\n","    metadata = {\n","        \"benchmark_name\": BENCHMARK_NAME,\n","        \"benchmark_version\": BENCHMARK_VERSION,\n","        \"research_focus\": RESEARCH_FOCUS,\n","        \"generated_at\": timestamp,\n","        \"random_seed\": seed,\n","        \"n_runs_per_scenario\": n_runs,\n","        \"models_tested\": models,\n","        \"n_scenarios\": len(scenarios),\n","        \"total_runs\": len(all_rows),\n","        \"temperature\": temperature,\n","        \"max_tokens\": max_tokens,\n","        \"max_turns\": max_turns\n","    }\n","    save_json(metadata, os.path.join(OUTPUT_DIR, \"metadata.json\"))\n","    print(f\"✓ Metadata: metadata.json\")\n","\n","    # RESEARCH: Save trajectory analysis (multi-turn patterns)\n","    trajectory_summary = {}\n","    for (model, sid), trajs in trajectory_data.items():\n","        avg_turns = round(statistics.mean([t[\"trajectory_turns\"] for t in trajs]), 2)\n","        avg_tool_attempts = round(statistics.mean([t[\"tool_attempts\"] for t in trajs]), 2)\n","        avg_clarifications = round(statistics.mean([t[\"clarification_turns\"] for t in trajs]), 2)\n","        trajectory_summary[f\"{model}_{sid}\"] = {\n","            \"avg_turns\": avg_turns,\n","            \"avg_tool_attempts\": avg_tool_attempts,\n","            \"avg_clarifications\": avg_clarifications\n","        }\n","    save_json(trajectory_summary, os.path.join(OUTPUT_DIR, \"trajectory_analysis.json\"))\n","    print(f\"✓ Trajectory analysis: trajectory_analysis.json\")\n","\n","    # RESEARCH: Visualization\n","    if not df.empty:\n","        fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n","\n","        # Boxplot by model\n","        df.boxplot(column=\"total_score\", by=\"model\", ax=axes[0], grid=False)\n","        axes[0].set_title(\"Score Distribution by Model\")\n","        axes[0].set_ylabel(\"Total Score (0-20)\")\n","        axes[0].set_xlabel(\"Model\")\n","\n","        # Mean with CI error bars\n","        g = summary_df.groupby(\"model\").agg({\"mean_score\": \"mean\", \"ci95_lower\": \"first\", \"ci95_upper\": \"first\"})\n","        if not g.empty:\n","            models_list = g.index\n","            means = g[\"mean_score\"]\n","            ci_lower = g[\"ci95_lower\"]\n","            ci_upper = g[\"ci95_upper\"]\n","            errors = [means - ci_lower, ci_upper - means]\n","            axes[1].bar(range(len(models_list)), means, yerr=errors, capsize=5, alpha=0.7)\n","            axes[1].set_xticks(range(len(models_list)))\n","            axes[1].set_xticklabels(models_list)\n","            axes[1].set_ylabel(\"Mean Score\")\n","            axes[1].set_title(\"Mean Score by Model (with 95% CI)\")\n","            axes[1].set_ylim([0, 20])\n","\n","        plt.tight_layout()\n","        plot_file = os.path.join(OUTPUT_DIR, \"score_analysis.png\")\n","        plt.savefig(plot_file, dpi=150)\n","        plt.close()\n","        print(f\"✓ Visualization: {plot_file}\")\n","\n","    # RESEARCH: LaTeX table for paper (includes pass@k now)\n","    latex_file = os.path.join(OUTPUT_DIR, \"results_table.txt\")\n","    with open(latex_file, \"w\", encoding=\"utf-8\") as f:\n","        f.write(\"% RESEARCH-GRADE RESULTS TABLE WITH pass@k METRIC\\n\")\n","        f.write(\"% Literature: τ-Bench, Anthropic Claude evaluations\\n\")\n","        f.write(\"% Include in paper with: \\\\input{results_table.txt}\\n\\n\")\n","        f.write(\"\\\\begin{table}[h]\\n\\\\centering\\n\\\\small\\n\")\n","        f.write(\"\\\\begin{tabular}{l l r r r r r}\\n\")\n","        f.write(\"\\\\hline\\n\")\n","      